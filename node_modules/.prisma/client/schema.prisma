generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int                      @id @default(autoincrement())
  username            String                   @unique
  email               String                   @unique
  password_hash       String
  role                Role                     @default(USER)
  profilePicture      String?
  isVerified          Boolean                  @default(false)
  verificationCode    String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  AiTip               AiTip[]
  auditLogs           AuditLog[]
  consentRecords      ConsentRecord[]
  ownedCourses        Course[]                 @relation("CourseOwner")
  editedCourses       CourseEditor[]
  documents           Document[]
  enrollments         Enrollment[]
  replies             ForumReply[]
  threads             ForumThread[]
  landingPages        LandingPage[]            @relation("MasterLandingPages")
  accessLogs          ModuleAccessLog[]
  moduleCompletions   ModuleCompletion[]
  downloads           ModuleDocumentDownload[]
  videoProgress       ModuleVideoProgress[]
  actorNotifications  Notification[]           @relation("NotificationActor")
  notifications       Notification[]           @relation("NotificationRecipient")
  passwordResetTokens PasswordResetToken[]
  portfolioItems      PortfolioItem[]
  submissions         QuizSubmission[]
  reminders           Reminder[]
  taskQueueItems      TaskQueueItem[]
  modules             TrainingModule[]         @relation("MasterModules")
  preferences         UserPreference?
  profile             UserProfile?
  roleAssignments     UserRoleAssignment[]
  placements          WorldModulePlacement[]   @relation("MasterPlacements")
  ownedChannels       Channel[]                @relation("ChannelOwner")
}

model UserProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  displayName     String?
  headline        String?
  bio             String?
  interests       String[] @default([])
  skills          String[] @default([])
  spokenLanguages String[] @default([])
  timezone        String?
  location        String?
  organization    String?
  course          String?
  websiteUrl      String?
  linkedinUrl     String?
  githubUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreference {
  id                    Int      @id @default(autoincrement())
  userId                Int      @unique
  language              String   @default("pt-BR")
  theme                 String   @default("system")
  emailNotifications    Boolean  @default(true)
  marketingEmails       Boolean  @default(false)
  allowProfileDiscovery Boolean  @default(true)
  showProfileInWorld    Boolean  @default(true)
  allowDirectMessages   Boolean  @default(true)
  reduceMotion          Boolean  @default(false)
  highContrast          Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserRoleAssignment {
  id         Int          @id @default(autoincrement())
  userId     Int
  role       AssignedRole
  active     Boolean      @default(true)
  isPrimary  Boolean      @default(false)
  assignedAt DateTime     @default(now())
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model ConsentRecord {
  id        Int         @id @default(autoincrement())
  userId    Int
  kind      ConsentKind
  granted   Boolean
  version   String
  source    String      @default("system")
  metadata  Json?
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PortfolioItem {
  id          Int      @id @default(autoincrement())
  userId      Int
  itemType    String   @default("LINK")
  title       String
  description String?
  url         String?
  highlight   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id               Int                  @id @default(autoincrement())
  userId           Int
  type             NotificationType
  status           NotificationStatus   @default(UNREAD)
  priority         NotificationPriority @default(MEDIUM)
  title            String
  message          String
  actionUrl        String?
  actorUserId      Int?
  sourceEntityType String?
  sourceEntityId   Int?
  metadata         Json?
  readAt           DateTime?
  archivedAt       DateTime?
  createdAt        DateTime             @default(now())
  actorUser        User?                @relation("NotificationActor", fields: [actorUserId], references: [id])
  user             User                 @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([type, createdAt])
}

model Reminder {
  id               Int                  @id @default(autoincrement())
  userId           Int
  type             NotificationType     @default(SYSTEM_REMINDER)
  status           ReminderStatus       @default(OPEN)
  priority         NotificationPriority @default(MEDIUM)
  title            String
  description      String?
  dueAt            DateTime?
  actionUrl        String?
  sourceEntityType String?
  sourceEntityId   Int?
  metadata         Json?
  completedAt      DateTime?
  dismissedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueAt])
}

model TaskQueueItem {
  id               Int                  @id @default(autoincrement())
  userId           Int
  type             NotificationType
  status           TaskQueueStatus      @default(PENDING)
  priority         NotificationPriority @default(MEDIUM)
  title            String
  summary          String?
  bucket           String               @default("TODAY")
  scheduledFor     DateTime?
  dueAt            DateTime?
  actionUrl        String?
  sourceEntityType String?
  sourceEntityId   Int?
  metadata         Json?
  completedAt      DateTime?
  dismissedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, bucket, dueAt])
}

model Document {
  id              Int              @id @default(autoincrement())
  userId          Int
  name            String
  type            String
  data            Bytes?
  createdAt       DateTime         @default(now())
  sizeBytes       Int?
  storageKey      String?
  storageProvider String           @default("database")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleDocs      ModuleDocument[]
}

model TrainingModule {
  id            Int                    @id @default(autoincrement())
  ownerMasterId Int
  title         String
  description   String?
  coverImage    String?
  status        ModuleStatus           @default(DRAFT)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  titleFont     String?
  textColor     String?
  AiTip         AiTip[]
  courseModules CourseModule[]
  threads       ForumThread[]
  accessLogs    ModuleAccessLog[]
  completions   ModuleCompletion[]
  documents     ModuleDocument[]
  videos        ModuleVideo[]
  quizzes       Quiz[]
  submissions   QuizSubmission[]
  master        User                   @relation("MasterModules", fields: [ownerMasterId], references: [id], onDelete: Cascade)
  placements    WorldModulePlacement[]
}

model Course {
  id            Int                    @id @default(autoincrement())
  ownerMasterId Int
  title         String
  description   String?
  coverImage    String?
  status        CourseStatus           @default(DRAFT)
  sceneId       String                 @unique
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  contentHtml   String?
  contentCss    String?
  AiTip         AiTip[]
  owner         User                   @relation("CourseOwner", fields: [ownerMasterId], references: [id], onDelete: Cascade)
  editors       CourseEditor[]
  courseModules CourseModule[]
  enrollments   Enrollment[]
  landingPage   LandingPage?           @relation("CourseLandingPage")
  completions   ModuleCompletion[]
  placements    WorldModulePlacement[]
  channels      ChannelCourse[]
}

model CourseEditor {
  id        Int      @id @default(autoincrement())
  courseId  Int
  userId    Int
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
}

model CourseModule {
  id               Int                   @id @default(autoincrement())
  courseId         Int
  moduleId         Int
  orderIndex       Int
  isRequired       Boolean               @default(false)
  requireQuizPass  Boolean               @default(false)
  minimumQuizScore Float?
  roomLabel        String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  course           Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module           TrainingModule        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  placement        WorldModulePlacement?

  @@unique([courseId, moduleId])
}

model Enrollment {
  id              Int              @id @default(autoincrement())
  courseId        Int
  userId          Int
  status          EnrollmentStatus @default(ENROLLED)
  progressPercent Float            @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
}

model ModuleCompletion {
  id          Int            @id @default(autoincrement())
  courseId    Int
  moduleId    Int
  userId      Int
  source      LogSource      @default(DASHBOARD)
  completedAt DateTime       @default(now())
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module      TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, moduleId, userId])
}

model ModuleVideo {
  id        Int                   @id @default(autoincrement())
  moduleId  Int
  title     String
  url       String
  order     Int
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  module    TrainingModule        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress  ModuleVideoProgress[]
}

model ModuleDocument {
  id         Int                      @id @default(autoincrement())
  moduleId   Int
  documentId Int
  title      String
  order      Int
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  document   Document                 @relation(fields: [documentId], references: [id], onDelete: Cascade)
  module     TrainingModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  downloads  ModuleDocumentDownload[]
}

model Quiz {
  id          Int              @id @default(autoincrement())
  moduleId    Int
  title       String
  order       Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  module      TrainingModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions   QuizQuestion[]
  submissions QuizSubmission[]
}

model QuizQuestion {
  id        Int          @id @default(autoincrement())
  quizId    Int
  text      String
  order     Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  answers   QuizAnswer[]
  options   QuizOption[]
  quiz      Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizOption {
  id         Int          @id @default(autoincrement())
  questionId Int
  text       String
  isCorrect  Boolean
  answers    QuizAnswer[]
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuizSubmission {
  id            Int            @id @default(autoincrement())
  moduleId      Int
  quizId        Int?
  userId        Int
  score         Float
  attemptNumber Int
  createdAt     DateTime       @default(now())
  answers       QuizAnswer[]
  module        TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quiz          Quiz?          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuizAnswer {
  id           Int            @id @default(autoincrement())
  submissionId Int
  questionId   Int
  optionId     Int
  option       QuizOption     @relation(fields: [optionId], references: [id], onDelete: Cascade)
  question     QuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  submission   QuizSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model ForumThread {
  id        Int            @id @default(autoincrement())
  moduleId  Int
  userId    Int
  title     String
  content   String
  createdAt DateTime       @default(now())
  replies   ForumReply[]
  module    TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ForumReply {
  id        Int         @id @default(autoincrement())
  threadId  Int
  userId    Int
  content   String
  createdAt DateTime    @default(now())
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ModuleAccessLog {
  id          Int            @id @default(autoincrement())
  moduleId    Int
  userId      Int
  placementId Int?
  sceneId     String?
  source      LogSource
  timestamp   DateTime       @default(now())
  module      TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ModuleVideoProgress {
  id        Int         @id @default(autoincrement())
  videoId   Int
  userId    Int
  progress  Float
  completed Boolean     @default(false)
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     ModuleVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
}

model ModuleDocumentDownload {
  id          Int            @id @default(autoincrement())
  moduleDocId Int
  userId      Int
  timestamp   DateTime       @default(now())
  moduleDoc   ModuleDocument @relation(fields: [moduleDocId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorldModulePlacement {
  id             Int             @id @default(autoincrement())
  ownerMasterId  Int
  courseId       Int?
  courseModuleId Int?            @unique
  moduleId       Int?
  sceneId        String
  objectType     String
  label          String?
  positionX      Float
  positionY      Float
  positionZ      Float
  rotationX      Float
  rotationY      Float
  rotationZ      Float
  scaleX         Float
  scaleY         Float
  scaleZ         Float
  status         PlacementStatus @default(ACTIVE)
  modelData      Bytes?
  idleAnim       String?
  interactedAnim String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  course         Course?         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseModule   CourseModule?   @relation(fields: [courseModuleId], references: [id])
  module         TrainingModule? @relation(fields: [moduleId], references: [id])
  master         User            @relation("MasterPlacements", fields: [ownerMasterId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  action     String
  entityType String
  entityId   Int?
  details    Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LandingPage {
  id            Int      @id @default(autoincrement())
  ownerMasterId Int
  title         String
  content       Json
  compiledHtml  String?
  compiledCss   String?
  courseId      Int?     @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  course        Course?  @relation("CourseLandingPage", fields: [courseId], references: [id])
  master        User     @relation("MasterLandingPages", fields: [ownerMasterId], references: [id], onDelete: Cascade)
}

model AiKnowledgeBaseConnection {
  id                      Int                       @id @default(autoincrement())
  tenantCode              String                    @default("default")
  displayName             String
  remoteType              String                    @default("internal_collection")
  remoteId                String
  remoteName              String?
  collectionName          String?
  isDefault               Boolean                   @default(false)
  status                  AiKnowledgeBaseStatus     @default(ACTIVE)
  lastRefreshAt           DateTime?
  lastError               String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  AiKnowledgeBaseSyncItem AiKnowledgeBaseSyncItem[]

  @@index([remoteType, remoteId])
  @@index([tenantCode, isDefault])
}

model AiKnowledgeBaseSyncItem {
  id                        Int                       @id @default(autoincrement())
  connectionId              Int
  sourceType                String
  sourceId                  String
  sourceHash                String?
  remoteFileId              String?
  remoteDocumentId          String?
  excluded                  Boolean                   @default(false)
  status                    AiKnowledgeSyncStatus     @default(PENDING)
  lastSyncedAt              DateTime?
  lastError                 String?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime
  AiKnowledgeBaseConnection AiKnowledgeBaseConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, sourceType, sourceId])
  @@index([status, updatedAt])
}

model AiTip {
  id             Int             @id @default(autoincrement())
  fingerprint    String          @unique
  userId         Int
  courseId       Int?
  moduleId       Int?
  scope          AiTipScope
  severity       AiTipSeverity   @default(INFO)
  title          String
  message        String
  reason         String?
  actionLabel    String?
  actionUrl      String?
  metadata       Json?
  status         AiTipStatus     @default(ACTIVE)
  generatedAt    DateTime        @default(now())
  dismissedAt    DateTime?
  expiresAt      DateTime?
  Course         Course?         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  TrainingModule TrainingModule? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  User           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId, status])
  @@index([moduleId, status])
  @@index([userId, status, generatedAt])
}

enum Role {
  USER
  ADMIN
  MASTER
}

enum AssignedRole {
  STUDENT
  TEACHER
  TUTOR
  BUSINESS_MENTOR
  COORDINATOR
  ADMIN
  GUEST
  SUPER_ADMIN
}

enum ConsentKind {
  TERMS_AND_PRIVACY
  MARKETING_EMAILS
  PROFILE_DISCOVERY
  WORLD_PROFILE_CARD
}

enum NotificationType {
  MODULE_PUBLISHED
  FORUM_REPLY
  QUIZ_SUBMITTED
  EVENT_INVITE
  ENROLLMENT_CREATED
  FEEDBACK_RECEIVED
  SYSTEM_REMINDER
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReminderStatus {
  OPEN
  COMPLETED
  DISMISSED
}

enum TaskQueueStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

enum ModuleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PlacementStatus {
  ACTIVE
  HIDDEN
  DELETED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ENROLLED
  COMPLETED
  CANCELLED
}

enum LogSource {
  DASHBOARD
  MULTIPLAYER_WORLD
}

enum AiKnowledgeBaseStatus {
  ACTIVE
  DISABLED
  ERROR
}

enum AiKnowledgeSyncStatus {
  PENDING
  SYNCED
  FAILED
  SKIPPED
  STALE
  DELETED
  DELETE_FAILED
}

enum AiTipScope {
  COURSE
  MODULE
  QUIZ
  SCHEDULE
  MATERIALS
}

enum AiTipSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AiTipStatus {
  ACTIVE
  DISMISSED
  STALE
}

model Channel {
  id               String          @id @default(cuid())
  ownerMasterId    Int
  owner            User            @relation("ChannelOwner", fields: [ownerMasterId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  thumb            String?
  modular_content  String?         @db.Text
  compiled_content String?         @db.Text
  status           CourseStatus    @default(PUBLISHED)
  courses          ChannelCourse[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model ChannelCourse {
  id        Int      @id @default(autoincrement())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([channelId, courseId])
}
